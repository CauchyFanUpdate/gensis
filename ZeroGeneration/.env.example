# ZeroGeneration — API 凭证模板
# 复制为 .env 后填入真实 key（.env 已被 .gitignore 忽略，切勿提交真实凭证）。
# 各 run_*.sh / generate_*.py 均从环境变量读取，未设置时回退到占位符 YOUR_*，会直接报错。

# ── GPT-Image-2（图像编辑/生成，外网 api.gpt.ge，Bearer auth，走系统代理）────────
GPT_IMAGE2_API_KEY=YOUR_GPT_IMAGE_API_KEY
GPT_IMAGE2_URL=https://api.gpt.ge/v1
# 部分脚本使用 GPT_IMAGE_API_KEY / GPT_IMAGE_ENDPOINT 命名，二者含义相同
GPT_IMAGE_API_KEY=YOUR_GPT_IMAGE_API_KEY
GPT_IMAGE_ENDPOINT=https://api.gpt.ge/v1

# ── Gemini 3.0 Pro（题面/编辑规划/CoT，内网 runway 代理）──────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.0-pro
# 视觉打分/校验用的 VL key（部分脚本用 GEMINI_VL_API_KEY 命名）
GEMINI_VL_API_KEY=YOUR_GEMINI_API_KEY
# Gemini 生图 helper（_gemini_image.py）
GEMINI_IMAGE_API_KEY=YOUR_GEMINI_IMAGE_API_KEY

# ── Qwen-VL / Qwen3.6-plus（Selector / Verifier / 文本改写，内网 runway 代理）──────
QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_API_BASE=https://runway.devops.xiaohongshu.com/openai/qwen/v1
QWEN_MODEL=qwen3.6-plus
# 历史兼容：未设 QWEN_API_KEY 时部分脚本回退到 OPENAI_API_KEY
OPENAI_API_KEY=YOUR_QWEN_API_KEY

# ── 并发 / 重试（可选，按配额调整）──────────────────────────────────────────────
GEMINI_MAX_CONCURRENT=16
QWEN_MAX_CONCURRENT=64
GPT_IMAGE_MAX_CONCURRENT=2
API_TIMEOUT=1200
MAX_RETRIES=6
