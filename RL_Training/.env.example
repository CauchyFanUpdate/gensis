# RL_Training 环境变量模板
# 复制为 .env（已被 .gitignore 忽略），或在提交训练前 export。
# 训练脚本原本把这些值硬编码，收录时已替换为 YOUR_* 占位符，请改用环境变量注入。

# ── 实验跟踪 ──────────────────────────────────────────────────────
WANDB_API_KEY=YOUR_WANDB_API_KEY
WANDB_MODE=online

# ── LLM Judge server（Qwen3-32B，vLLM OpenAI-兼容端点）──────────────
# 训练进程通过 HTTP 调用；judge 的 api-key/model-name 约定为字面量 "qwen"
JUDGE_HOST=10.144.204.172
JUDGE_PORT=31001
JUDGE_TP=4
JUDGE_MODEL_PATH=/path/to/model/Qwen3-32B
# 由训练脚本组装：JUDGE_BASE_URL=http://${JUDGE_HOST}:${JUDGE_PORT}/v1

# ── eval 用的判分 API（OpenAI-兼容）────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── 训练输入（parquet）与模型/输出路径 ─────────────────────────────
MODEL_PATH=/path/to/model/Qwen3-VL-4B-Instruct
TRAIN_FILE=/path/to/ZeroGeneration/gen_zerobench_output_v5/parquet/merged_validated.parquet
VAL_FILE=/path/to/zerovision/dataset/parquets/MMMU.parquet
VERL_ROOT=/path/to/verl          # 套用了 verl_custom 的 verl 根目录

# ── 多机（K8s / 手动）─────────────────────────────────────────────
# 由平台注入：MASTER_ADDR / HOST_IP / POD_NAME(含 master 为 head) / WORLD_SIZE
WORLD_SIZE=6
N_GPUS_PER_NODE=8
